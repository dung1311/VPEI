# ── App ──────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
APP_NAME=VPEI
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_32BYTE_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./vpei.db

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# 1. Google Account → Security → 2-Step Verification (must be ON)
# 2. Search "App passwords" → create one for "Mail"
# 3. Paste the 16-char password below (spaces are stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_NAME=VPEI System
SMTP_ENABLED=false

# ── Super admin (seed lần đầu khi init_db, nếu chưa có user trùng username) ──
VPEI_SUPERADMIN_USERNAME=vpeiadmin
VPEI_SUPERADMIN_PASSWORD=123123123
VPEI_SUPERADMIN_EMAIL=vpeiadmin@gmail.com
VPEI_SUPERADMIN_FULL_NAME=VPEI Super Administrator
